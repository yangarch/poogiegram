# poogiegram 환경 설정
#   cp .env.example .env  후 값을 채운다. .env 는 커밋하지 않는다.

# ── 경로 (§4.1) ──────────────────────────────────────────────────────────
# MEDIA_ROOT 아래에 originals/ incoming/ trash/ db/ .tmp/ 가 있어야 한다.
MEDIA_ROOT=/mnt/media
DERIVED_ROOT=/var/lib/poogiegram/derived

# 기동 시 originals/ 안에서 확인하는 마커 파일 (§4.6).
# 외장 디스크가 마운트되지 않은 채로 앱이 뜨면 빈 디렉터리에 원본을 쓰게 되므로,
# 이 파일이 없으면 기동을 거부한다.
STORAGE_MARKER=.poogiegram-ok

# ── API (§3.1) ───────────────────────────────────────────────────────────
# 호스트에는 127.0.0.1 로만 바인딩한다. 외부 노출은 호스트 nginx 가 담당.
API_PORT=8005
SECRET_KEY=change-me
# 생성:  openssl rand -hex 32

# ── PostgreSQL (§3.1 — 호스트에 포트를 노출하지 않는다) ────────────────────
POSTGRES_DB=poogiegram
POSTGRES_USER=poogiegram
POSTGRES_PASSWORD=change-me

# ── 트랜스코딩 (§6.3, §6.4) ───────────────────────────────────────────────
# auto = 기동 시 VA-API 엔트리포인트를 탐지해 결정. 실패하면 libx264 로 폴백.
TRANSCODE_HWACCEL=auto
TRANSCODE_CONCURRENCY=2
TRANSCODE_MAX_HEIGHT=1080

# 컨테이너가 /dev/dri/renderD128 에 접근하려면 호스트의 render 그룹 GID 가 필요하다.
#   getent group render | cut -d: -f3
RENDER_GID=993

# 컨테이너가 미디어 파일을 읽고 옮기려면 호스트의 poogiegram 그룹 자격이 필요하다.
# 이게 없으면 컨테이너 안에서만 Permission denied 가 나고 호스트에서는 정상이라
# 원인을 찾기 어렵다. RENDER_GID 와 같은 구조다.
#   getent group poogiegram | cut -d: -f3
POOGIEGRAM_GID=1001

# ── 인제스트 (§6.1) ───────────────────────────────────────────────────────
# 드롭 폴더를 몇 초마다 스캔할지. inotify 는 가속용이고 정확성은 이 스캔이 보장한다.
INGEST_SCAN_INTERVAL_SECONDS=300
# 파일 크기·mtime 이 이만큼 변하지 않아야 처리 대상으로 삼는다.
# 업로드 중인 파일을 잘린 채로 집어가지 않기 위한 안전장치.
INGEST_STABLE_SECONDS=30
